{
  "id": "validation-test",
  "title": "Validation Test",
  "sections": [
    {
      "id": "test-section",
      "title": "Validation Test Section",
      "questions": [
        {
          "id": "required-test",
          "type": "text",
          "label": "Required Field",
          "required": true
        },
        {
          "id": "minLength-test",
          "type": "text",
          "label": "Min Length (minLength: 5)",
          "required": false,
          "validation": [
            { "type": "minLength", "value": 5 }
          ]
        },
        {
          "id": "maxLength-test",
          "type": "text",
          "label": "Max Length (maxLength: 10)",
          "required": false,
          "validation": [
            { "type": "maxLength", "value": 10 }
          ]
        },
        {
          "id": "min-test",
          "type": "number",
          "label": "Min Value (min: 18)",
          "required": false,
          "validation": [
            { "type": "min", "value": 18 }
          ]
        },
        {
          "id": "max-test",
          "type": "number",
          "label": "Max Value (max: 100)",
          "required": false,
          "validation": [
            { "type": "max", "value": 100 }
          ]
        },
        {
          "id": "minMaxLength-test",
          "type": "text",
          "label": "Min & Max Length (5-10 chars)",
          "required": false,
          "validation": [
            { "type": "minLength", "value": 5 },
            { "type": "maxLength", "value": 10 }
          ]
        },
        {
          "id": "minMax-test",
          "type": "number",
          "label": "Min & Max Value (18-100)",
          "required": false,
          "validation": [
            { "type": "min", "value": 18 },
            { "type": "max", "value": 100 }
          ]
        },
        {
          "id": "required-minLength-test",
          "type": "text",
          "label": "Required + Min Length (minLength: 3)",
          "required": true,
          "validation": [
            { "type": "minLength", "value": 3 }
          ]
        },
        {
          "id": "required-minMax-test",
          "type": "number",
          "label": "Required + Min & Max (18-100)",
          "required": true,
          "validation": [
            { "type": "min", "value": 18 },
            { "type": "max", "value": 100 }
          ]
        },
        {
          "id": "all-text-validations",
          "type": "text",
          "label": "All Text Validations (required + 5-20 chars)",
          "required": true,
          "validation": [
            { "type": "minLength", "value": 5 },
            { "type": "maxLength", "value": 20 }
          ]
        },
        {
          "id": "all-number-validations",
          "type": "number",
          "label": "All Number Validations (required + 10-50)",
          "required": true,
          "validation": [
            { "type": "min", "value": 10 },
            { "type": "max", "value": 50 }
          ]
        }
      ]
    },
    {
      "id": "actions-test-section",
      "title": "Actions Test Section",
      "questions": [
        {
          "id": "age-question",
          "type": "number",
          "label": "What is your age? (if >= 18 show adult-question, if >= 65 show also senior-question)",
          "required": false
        },
        {
          "id": "adult-question",
          "type": "text",
          "label": "Adult-specific question (shown when age >= 18)",
          "required": false,
          "visible": false
        },
        {
          "id": "senior-question",
          "type": "text",
          "label": "Senior-specific question (shown when age >= 65)",
          "required": false,
          "visible": false
        },
        {
          "id": "has-license",
          "type": "multiple-choice",
          "label": "Do you have a driver's license? (if yes show license-number)",
          "required": false,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "id": "license-number",
          "type": "text",
          "label": "License Number (shown when has-license = 'yes')",
          "required": false,
          "visible": false
        }
      ]
    },
    {
      "id": "combined-actions-validation-section",
      "title": "Combined Actions & Validation Test Section",
      "questions": [
        {
          "id": "validated-age",
          "type": "number",
          "label": "Your Age (required, 18-100) - triggers conditional questions",
          "required": true,
          "validation": [
            { "type": "min", "value": 18 },
            { "type": "max", "value": 100 }
          ]
        },
        {
          "id": "adult-email",
          "type": "text",
          "label": "Email Address (shown when age >= 18, required, minLength: 5)",
          "required": true,
          "visible": false,
          "validation": [
            { "type": "minLength", "value": 5 }
          ]
        },
        {
          "id": "senior-medical-id",
          "type": "text",
          "label": "Medical ID (shown when age >= 65, required, 8-12 chars)",
          "required": true,
          "visible": false,
          "validation": [
            { "type": "minLength", "value": 8 },
            { "type": "maxLength", "value": 12 }
          ]
        },
        {
          "id": "minor-guardian",
          "type": "text",
          "label": "Guardian Name (shown when age < 18, required, minLength: 3)",
          "required": true,
          "visible": false,
          "validation": [
            { "type": "minLength", "value": 3 }
          ]
        },
        {
          "id": "insurance-type",
          "type": "multiple-choice",
          "label": "Insurance Type (required) - triggers validated field",
          "required": true,
          "options": [
            "Private",
            "Public",
            "None"
          ]
        },
        {
          "id": "insurance-number",
          "type": "text",
          "label": "Insurance Number (shown when insurance-type = 'Private', required, 10-15 chars)",
          "required": true,
          "visible": false,
          "validation": [
            { "type": "minLength", "value": 10 },
            { "type": "maxLength", "value": 15 }
          ]
        },
        {
          "id": "has-chronic-condition",
          "type": "multiple-choice",
          "label": "Do you have a chronic condition? (required)",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "id": "condition-details",
          "type": "text",
          "label": "Condition Details (shown when has-chronic-condition = 'Yes', required, 10-200 chars)",
          "required": true,
          "visible": false,
          "validation": [
            { "type": "minLength", "value": 10 },
            { "type": "maxLength", "value": 200 }
          ]
        },
        {
          "id": "medication-count",
          "type": "number",
          "label": "Number of Medications (shown when has-chronic-condition = 'Yes', required, 1-20)",
          "required": true,
          "visible": false,
          "validation": [
            { "type": "min", "value": 1 },
            { "type": "max", "value": 20 }
          ]
        }
      ]
    },
    {
      "id": "formulas-test-section",
      "title": "Formulas Test Section",
      "questions": [
        {
          "id": "formula-num1",
          "type": "number",
          "label": "Number 1 (for formula testing)",
          "required": false
        },
        {
          "id": "formula-num2",
          "type": "number",
          "label": "Number 2 (for formula testing)",
          "required": false
        },
        {
          "id": "formula-num3",
          "type": "number",
          "label": "Number 3 (for formula testing)",
          "required": false
        },
        {
          "id": "formula-num4",
          "type": "number",
          "label": "Number 4 (for formula testing)",
          "required": false
        },
        {
          "id": "formula-num5",
          "type": "number",
          "label": "Number 5 (for formula testing)",
          "required": false
        }
      ]
    }
  ],
  "formulas": [
    {
      "id": "sum-basic",
      "expression": "sum(formula-num1, formula-num2, formula-num3)"
    },
    {
      "id": "sum-mixed",
      "expression": "sum(formula-num1, 10, formula-num2, 5)"
    },
    {
      "id": "sum-single",
      "expression": "sum(formula-num1)"
    },
    {
      "id": "arithmetic-add",
      "expression": "formula-num1 + formula-num2"
    },
    {
      "id": "arithmetic-subtract",
      "expression": "formula-num1 - formula-num2"
    },
    {
      "id": "arithmetic-multiply",
      "expression": "formula-num1 * formula-num2"
    },
    {
      "id": "arithmetic-divide",
      "expression": "formula-num1 / formula-num2"
    },
    {
      "id": "arithmetic-complex",
      "expression": "(formula-num1 + formula-num2) * formula-num3"
    },
    {
      "id": "formula-dependency",
      "expression": "sum-basic * 2"
    },
    {
      "id": "formula-nested",
      "expression": "sum(sum-basic, formula-num4, formula-num5)"
    },
    {
      "id": "formula-complex",
      "expression": "(sum-basic + formula-num4) / 2"
    }
  ],
  "actions": [
    {
      "type": "show",
      "condition": "age-question >= 18",
      "target": "adult-question"
    },
    {
      "type": "show",
      "condition": "age-question >= 65",
      "target": "senior-question"
    },
    {
      "type": "show",
      "condition": "has-license == 'Yes'",
      "target": "license-number"
    },
    {
      "type": "hide",
      "condition": "has-license == 'No'",
      "target": "license-number"
    },
    {
      "type": "show",
      "condition": "validated-age >= 18",
      "target": "adult-email"
    },
    {
      "type": "hide",
      "condition": "validated-age < 18",
      "target": "adult-email"
    },
    {
      "type": "show",
      "condition": "validated-age >= 65",
      "target": "senior-medical-id"
    },
    {
      "type": "hide",
      "condition": "validated-age < 65",
      "target": "senior-medical-id"
    },
    {
      "type": "show",
      "condition": "validated-age < 18",
      "target": "minor-guardian"
    },
    {
      "type": "hide",
      "condition": "validated-age >= 18",
      "target": "minor-guardian"
    },
    {
      "type": "show",
      "condition": "insurance-type == 'Private'",
      "target": "insurance-number"
    },
    {
      "type": "hide",
      "condition": "insurance-type != 'Private'",
      "target": "insurance-number"
    },
    {
      "type": "show",
      "condition": "has-chronic-condition == 'Yes'",
      "target": "condition-details"
    },
    {
      "type": "show",
      "condition": "has-chronic-condition == 'Yes'",
      "target": "medication-count"
    },
    {
      "type": "hide",
      "condition": "has-chronic-condition == 'No'",
      "target": "condition-details"
    },
    {
      "type": "hide",
      "condition": "has-chronic-condition == 'No'",
      "target": "medication-count"
    }
  ]
}
